#!/usr/bin/env bash
# zsc - knife-set CLI, WSL side. Thin router over the repo's scripts.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

usage() {
  cat <<'EOF'
zsc - knife-set setup CLI (WSL side)

  zsc setup     install.sh + deploy.sh (full bootstrap)
  zsc install   packages only (apt, starship, mise, TPM, workmux)
  zsc deploy    push configs only
  zsc pentest   bug-hunt toolkit: pdtm suite, massdns, Caido, wordlists
  zsc skills   agent skills: install / update / doctor / schedule (skills-packages.txt)
  zsc update    git pull this repo, redeploy
  zsc doctor    health check: tools, TPM, tmux.conf, config drift
EOF
}

doctor() {
  local fail=0
  echo "== tools =="
  for c in zsh tmux nvim fzf zoxide eza bat rg fd starship mise lazygit workmux git delta; do
    if command -v "$c" >/dev/null 2>&1; then echo "  ok      $c"
    else echo "  MISSING $c   -> zsc install"; fail=$((fail+1)); fi
  done
  echo "== tmux =="
  [[ -d ~/.tmux/plugins/tpm ]] && echo "  ok      tpm" || { echo "  MISSING tpm   -> zsc install"; fail=$((fail+1)); }
  for f in ~/.config/tmux/tmux.conf ~/.config/tmux/tmux.reset.conf; do
    [[ -f $f ]] && echo "  ok      $f" || { echo "  MISSING $f   -> zsc deploy"; fail=$((fail+1)); }
  done
  echo "== config drift =="
  drift() {
    local src=$1 dst=$2
    [[ -f $dst ]] || { echo "  absent  $dst   -> zsc deploy"; fail=$((fail+1)); return; }
    cmp -s "$src" "$dst" && echo "  ok      $dst" || { echo "  drift   $dst   -> zsc deploy"; fail=$((fail+1)); }
  }
  drift "$REPO_DIR/.zshrc" ~/.zshrc
  drift "$REPO_DIR/tmux/tmux.conf" ~/.config/tmux/tmux.conf
  drift "$REPO_DIR/lazygit/config.yml" ~/.config/lazygit/config.yml
  drift "$REPO_DIR/nvim/init.lua" ~/.config/nvim/init.lua

  echo "== pentest toolkit (optional - zsc pentest) =="
  local pt=0
  for c in go pdtm subfinder shuffledns dnsx naabu httpx katana urlfinder nuclei massdns caido; do
    if command -v "$c" >/dev/null 2>&1; then echo "  ok      $c"; pt=$((pt+1)); fi
  done
  (( pt == 0 )) && echo "  not installed  -> zsc pentest"
  [[ -f $HOME/tools/lists/resolvers-trickest.txt ]] && echo "  ok      ~/tools/lists/resolvers-trickest.txt" \
    || echo "  absent  ~/tools/lists/resolvers-trickest.txt   -> zsc pentest"

  if (( fail > 0 )); then echo; echo "$fail issue(s). Fix with: zsc install / zsc deploy"; exit 1; fi
  echo; echo "all green."
}

skills_usage() {
  cat <<'EOF'
usage: zsc skills <command>

  install    add every repo in skills-packages.txt to ~/.agents/skills
  update     update all installed skills (npx vercel-labs skills CLI)
  doctor     check store, ~/.claude/skills link, node version
  schedule   weekly auto-update task (Windows only)
EOF
}

skills_win_store() {
  local d
  for d in /mnt/c/Users/*/.agents/skills; do
    [[ -d $d ]] && { echo "$d"; return 0; }
  done
  return 0
}

skills_ensure_link() {   # skills_ensure_link TARGET - link ~/.claude/skills -> TARGET; never touch what exists
  local target=$1 link="$HOME/.claude/skills"
  if [[ -L $link ]]; then
    local cur
    cur="$(readlink "$link")"
    [[ $cur == "$target" ]] && return 0
    echo "warning: $link -> $cur (expected $target) - leaving it alone"
    return 0
  fi
  if [[ -e $link ]]; then
    echo "warning: $link exists and is not a symlink (expected -> $target) - leaving it alone"
    return 0
  fi
  mkdir -p "$HOME/.claude"
  ln -sfn "$target" "$link"
  echo "linked: $link -> $target"
}

skills_update() {
  command -v npx >/dev/null 2>&1 || { echo "npx not found - skipping skills update (needs Node >= 22.20)"; return 0; }
  echo "==> skills update"
  npx --yes skills@latest update -g -y </dev/null || echo "skills update failed"
}

skills_install() {
  command -v npx >/dev/null 2>&1 || { echo "npx not found - install Node >= 22.20, then re-run: zsc skills install"; return 0; }

  local win_store store line repo sel fail=0
  win_store="$(skills_win_store)"
  if [[ -n $win_store ]]; then
    skills_ensure_link "$win_store"
    if [[ -e $HOME/.agents/skills && ! -L $HOME/.agents/skills ]]; then
      echo "warning: ~/.agents/skills exists as a real dir - WSL pi/Kimi/OpenCode keep their own store; leaving it alone"
    else
      mkdir -p "$HOME/.agents"
      ln -sfn "$win_store" "$HOME/.agents/skills"
      echo "linked: ~/.agents/skills -> $win_store"
    fi
    echo "skills store is Windows-side ($win_store) - installs run from Windows: zsc skills install in PowerShell"
    return 0
  fi

  store="$HOME/.agents/skills"
  mkdir -p "$store"
  skills_ensure_link "$store"

  while IFS= read -r line || [[ -n $line ]]; do
    line="${line//[[:space:]]/}"
    [[ -z $line || $line == \#* ]] && continue
    repo="${line%%:*}"
    sel="${line#*:}"
    [[ $line != *:* ]] && sel='*'
    read -ra sels <<< "${sel//,/ }"
    echo "==> $repo"
    npx --yes skills@latest add "$repo" -g -y -a pi -a claude-code -a github-copilot -s "${sels[@]}" </dev/null \
      || { echo "  failed  $repo"; fail=$((fail+1)); }
  done < "$REPO_DIR/skills-packages.txt"

  if (( fail > 0 )); then
    echo "$fail skill repo(s) failed"
    return 1
  fi
  echo "done. skills live in $store - pi / Kimi / OpenCode read it natively."
}

skills_doctor() {
  local fail=0 win_store store expected link target ver
  win_store="$(skills_win_store)"
  store="$HOME/.agents/skills"
  expected="$store"

  echo "== skills store =="
  if [[ -n $win_store ]]; then
    echo "  windows $win_store (WSL links here)"
    expected="$win_store"
  elif [[ -d $store ]]; then
    local n
    n="$(find "$store" -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l)"
    echo "  ok      $store ($n skills)"
  else
    echo "  MISSING $store   -> zsc skills install"
    fail=$((fail+1))
  fi

  echo "== claude link =="
  link="$HOME/.claude/skills"
  if [[ -L $link ]]; then
    target="$(readlink "$link")"
    if [[ $target == "$expected" ]]; then
      echo "  ok      $link -> $target"
    else
      echo "  WRONG   $link -> $target (expected $expected)"
      fail=$((fail+1))
    fi
  elif [[ -e $link ]]; then
    echo "  REALDIR $link is a real directory (expected symlink -> $expected)"
    fail=$((fail+1))
  else
    echo "  MISSING $link   -> zsc skills install"
    fail=$((fail+1))
  fi

  echo "== agents link =="
  if [[ -n $win_store ]]; then
    link="$HOME/.agents/skills"
    if [[ -L $link ]]; then
      echo "  ok      $link -> $(readlink "$link")"
    elif [[ -e $link ]]; then
      echo "  REALDIR $link is a real dir - WSL pi/Kimi/OpenCode use their own store"
    else
      echo "  MISSING $link   -> zsc skills install"
      fail=$((fail+1))
    fi
  fi

  echo "== hazards =="
  if [[ -e $HOME/.config/agents/skills ]]; then
    echo "  HAZARD  ~/.config/agents/skills exists - Kimi CLI would stop using the store; remove it"
    fail=$((fail+1))
  else
    echo "  ok      no ~/.config/agents/skills"
  fi

  echo "== node =="
  if ! command -v node >/dev/null 2>&1; then
    echo "  MISSING node   -> install Node >= 22.20 (npx needs it)"
    fail=$((fail+1))
  else
    ver="$(node --version 2>/dev/null || true)"
    ver="${ver#v}"
    if [[ $(printf '%s\n' "$ver" 22.20.0 | sort -V | head -1) == 22.20.0 ]]; then
      echo "  ok      node $ver"
    else
      echo "  OLD     node ${ver:-unknown}   needs >= 22.20.0"
      fail=$((fail+1))
    fi
  fi

  if (( fail > 0 )); then echo; echo "$fail issue(s). Fix with: zsc skills install"; exit 1; fi
  echo; echo "all green."
}

skills_cmd() {
  case "${1:-}" in
    install)  skills_install ;;
    update)   skills_update ;;
    doctor)   skills_doctor ;;
    schedule) echo "not supported on WSL, run on Windows" ;;
    help|-h|--help) skills_usage ;;
    *) skills_usage; exit 1 ;;
  esac
}

case "$cmd" in
  setup)   bash "$REPO_DIR/install.sh" && bash "$REPO_DIR/deploy.sh" ;;
  install) bash "$REPO_DIR/install.sh" "$@" ;;
  deploy)  bash "$REPO_DIR/deploy.sh" "$@" ;;
  pentest) bash "$REPO_DIR/pentest.sh" "$@" ;;
  skills) skills_cmd "$@" ;;
  update)  git -C "$REPO_DIR" pull --ff-only && bash "$REPO_DIR/deploy.sh" && skills_update ;;
  doctor)  doctor ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
